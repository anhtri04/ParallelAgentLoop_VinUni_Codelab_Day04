# Copy this file to .env and fill in your keys.
# cp .env.example .env  (run inside starter-code/)

# --- OpenAI-compatible API (DeepSeek defaults) ---
# DeepSeek: get key at https://platform.deepseek.com/api_keys
# Compatible with any OpenAI-style endpoint (OpenAI, DeepSeek, local Ollama/vLLM, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Aliases (optional, auto-detected if LLM_* not set):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# DEEPSEEK_API_KEY=
